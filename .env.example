APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Job sources / AI (see README + integration.md) ---
# groq | agnes | anthropic | failover (failover = Gemini/Groq/DeepSeek with automatic fallback, managed at /agent/settings/providers)
AI_PROVIDER=failover
GROQ_API_KEY=
RESUME_AI_PROVIDER=failover
AGNES_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
HUNTER_API_KEY=

# --- ATS boards: reading needs NO key ---
# vendor:slug, comma-separated
ATS_BOARDS=
# --- ATS apply: employer-issued keys only (board-slug:key,...) ---
GREENHOUSE_BOARD_KEYS=
LEVER_SITE_KEYS=

# --- Third-party apply service (async, webhook callback) ---
APPLY_SERVICE_BASE_URL=https://apply-api.boringproject.ai/api/v1
APPLY_SERVICE_API_KEY=
APPLY_SERVICE_PROFILE_ID=
APPLY_SERVICE_WEBHOOK_SECRET=
APPLY_SERVICE_SIGNATURE_HEADER=X-Signature

# --- Auto-apply safety rails ---
AUTO_APPLY_LIVE=false
AUTO_APPLY_MAX_PER_RUN=10
AUTO_APPLY_MAX_AGE_HOURS=72

# --- Translation (non-English jobs are translated ONCE, stored; the button only shows the stored text) ---
# Tried in this order; unconfigured/over-quota drivers are skipped.
TRANSLATE_DRIVERS=deepl,azure,libretranslate,mymemory,ai
DEEPL_API_KEY=                 # free key from deepl.com/pro-api (ends in :fx), 500K chars/month
AZURE_TRANSLATOR_KEY=          # Azure AI Translator, free F0 tier = 2M chars/month
AZURE_TRANSLATOR_REGION=       # e.g. westeurope (empty for a Global resource)
LIBRETRANSLATE_URL=            # self-hosted, e.g. http://localhost:5000 (unlimited)
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=                # any real email: raises MyMemory from 5,000 to 50,000 chars/day
TRANSLATE_MAX_CHARS_PER_JOB=3500
TRANSLATE_PER_RUN=15

# --- Social job posts ---
SOCIAL_SOURCES=hackernews,mastodon,bluesky,lemmy   # add reddit, github, x once configured
BLUESKY_HANDLE=                # free account handle, e.g. you.bsky.social
BLUESKY_APP_PASSWORD=          # Bluesky Settings > Privacy and Security > App Passwords (NOT your main password)
SOCIAL_LOOKBACK_HOURS=48
SOCIAL_AI_PER_RUN=20
MASTODON_INSTANCES=mastodon.social,fosstodon.org
X_BEARER_TOKEN=                # X API v2 (pay-per-use). Leave empty to keep X off.
X_DAILY_READ_BUDGET=150        # posts/day you are willing to pay to read

# Lemmy: free, no key (public API). Optional communities as name@instance.
LEMMY_INSTANCES=lemmy.world,programming.dev
LEMMY_COMMUNITIES=
# Reddit: official API. Free for NON-COMMERCIAL use; register an app at reddit.com/prefs/apps (may need approval).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="web:job-feed:1.0 (by /u/your-reddit-username)"
REDDIT_SUBREDDITS=forhire
# GitHub has no jobs feed. List repos where openings are posted as issues: owner/repo,owner/repo
GITHUB_JOB_REPOS=
GITHUB_TOKEN=

# --- Employers (posting limits) ---
EMPLOYER_MAX_ACTIVE_JOBS=10
EMPLOYER_MAX_PUBLISHES_PER_DAY=5

# --- Opportunity Agent (/agent) ---
AGENT_OWNER_EMAILS=            # who may open /agent (comma separated). Empty = the first account registered
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# GROQ_API_KEY is shared with the job features above
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# optional model overrides: GEMINI_MODEL, DEEPSEEK_MODEL (GROQ_MODEL above)
RESEARCH_RUN_MODE=queue        # "sync" if you can't run the queue cron
RESEARCH_CONTACT_EMAIL=        # shown in the research crawler's User-Agent
