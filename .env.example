##############################################################################
# HOW TO READ THIS FILE
#   [MUST]    the app will not work without it
#   [AI]      needed for resume parsing, research, discovery, outreach drafts
#             (you need AT LEAST ONE AI key, more = automatic fallback)
#   [SEARCH]  needed for research + discovery (AT LEAST ONE search key)
#   [OPTIONAL] leave empty / default if you don't need it
# Everything with a value already is a safe default.
##############################################################################

# ============================ [MUST] App & database ============================
APP_NAME="Opportunity Agent"
# "local" on your own machine
APP_ENV=production
# [MUST] run: php artisan key:generate
APP_KEY=
# keep false on the live site
APP_DEBUG=false
# [MUST] your real URL (used in email links)
APP_URL=https://your-domain.com
# daily email alerts go out after 07:00 in THIS timezone
APP_TIMEZONE=Africa/Lagos

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# [MUST] from cPanel > MySQL Databases
DB_DATABASE=
# [MUST]
DB_USERNAME=
# [MUST]
DB_PASSWORD=

# Owner = who may open /agent (outreach tools). Comma separated. Empty = the first account registered.
AGENT_OWNER_EMAILS=

# cPanel-friendly defaults: no Redis/Node needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
# needs the queue cron (see README)
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ============================ [MUST for emails] Mail ============================
# Job alerts, password resets. MAIL_MAILER=log just writes emails to storage/logs (nothing is sent).
# On cPanel: create a mailbox, then use smtp with its details.
MAIL_MAILER=smtp
# e.g. mail.your-domain.com
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alerts@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# IMPORTANT: put the key right after the = sign, no spaces, no quotes needed, nothing after it.
# ---- Portfolio brief API (POST /api/amowogbajewebsite/send-brief) uses the MAIL_* settings above ----
BRIEF_TO=hello@amowogbaje.com
BRIEF_BCC=amowogbajegideon@gmail.com

# ============================ [AI] Choose at least one ============================
# Managed on the Providers page (/agent/providers): order, on/off, daily limits, test button.
# free: aistudio.google.com/apikey
GEMINI_API_KEY=
# free: console.groq.com/keys  (also used for resume parsing)
GROQ_API_KEY=
# platform.deepseek.com
DEEPSEEK_API_KEY=
# Optional model overrides (defaults are set in config/ai.php):
# GEMINI_MODEL=
# GROQ_MODEL=openai/gpt-oss-120b
# DEEPSEEK_MODEL=
# Keep these on "failover" so every AI feature uses the providers above:
AI_PROVIDER=failover
RESUME_AI_PROVIDER=failover
# Old single-provider options, only if you switch AI_PROVIDER away from failover:
# AGNES_API_KEY=
# ANTHROPIC_API_KEY=
# Safety caps (per day / per call):
AI_CALLS_PER_DAY=300
AI_TIMEOUT=60

# ============================ [SEARCH] Choose at least one ============================
# Used by Research and Discovery. Switch between them on the Providers page.
# NEEDS A CARD per your signup. Skip unless you have one: tavily.com
TAVILY_API_KEY=
# No card: serper.dev, 2,500 free searches on signup (one-off, not monthly)
SERPER_API_KEY=
# Brave removed its free tier and requires a card at signup. Skip.
BRAVE_SEARCH_API_KEY=
# SerpApi free plan, 250 searches/month. Card requirement not confirmed; signup may ask for phone verification
SERPAPI_API_KEY=
# No card (per Exa pricing page): dashboard.exa.ai, $10 bonus + $10 every month (~2,500 searches/month)
EXA_API_KEY=
# No card (per Firecrawl pricing page): firecrawl.dev, 1,000 credits/month (~500 searches)
FIRECRAWL_API_KEY=
# Jina: key is free from jina.ai (limits not confirmed). Works with a key; the no-key mode is rate limited
JINA_API_KEY=
# your own SearXNG instance, e.g. https://search.example.com (no key)
SEARXNG_URL=
SEARCH_CALLS_PER_DAY=150

# ============================ Research & Discovery behaviour ============================
# "sync" runs inside the page request if you can't set up the queue cron
RESEARCH_RUN_MODE=queue
# [recommended] your email, shown in the crawler's User-Agent so sites can reach you
RESEARCH_CONTACT_EMAIL=

# searches per discovery run
# Build a tailored resume from your Profile automatically when research on an opportunity finishes
AGENT_AUTO_RESUME=true

DISCOVERY_MAX_QUERIES=4
DISCOVERY_RESULTS_PER_QUERY=6
# new opportunities saved per run
DISCOVERY_MAX_CANDIDATES=12
# protects your free search/AI quotas
DISCOVERY_RUNS_PER_DAY=12
DISCOVERY_AUTO_RESEARCH_CAP=5
# off | daily (05:30, hiring + external-assistance for every active service)
DISCOVERY_SCHEDULE=off

# ============================ Job feed sources ============================
# Arbeitnow, RemoteOK, WeWorkRemotely and Himalayas need NO key.
# [OPTIONAL] free: developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# gb, us, ng, de ...
ADZUNA_COUNTRY=gb
ADZUNA_SEARCH_TERM="software developer"

# Company job boards to read (no key needed), comma separated vendor:slug.
# Each user can also add their own on the Job interests page.
# e.g. greenhouse:stripe,lever:spotify,ashby:linear
ATS_BOARDS=

# ============================ Social hiring posts ============================
# add reddit, github, x once configured
SOCIAL_SOURCES=hackernews,mastodon,bluesky,lemmy
SOCIAL_LOOKBACK_HOURS=48
# AI extractions per run (only posts that already match someone's skills)
SOCIAL_AI_PER_RUN=20
MASTODON_INSTANCES=mastodon.social,fosstodon.org
# [OPTIONAL] free account, e.g. you.bsky.social
BLUESKY_HANDLE=
# Bluesky > Settings > App Passwords (NOT your main password)
BLUESKY_APP_PASSWORD=
LEMMY_INSTANCES=lemmy.world,programming.dev
LEMMY_COMMUNITIES=
# [OPTIONAL] reddit.com/prefs/apps (non-commercial use)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="web:job-feed:1.0 (by /u/your-reddit-username)"
REDDIT_SUBREDDITS=forhire
# owner/repo,owner/repo (repos that post openings as issues)
GITHUB_JOB_REPOS=
GITHUB_TOKEN=
# [OPTIONAL, paid] leave empty to keep X off
X_BEARER_TOKEN=
X_DAILY_READ_BUDGET=150

# ============================ Translation (non-English jobs) ============================
# Translated once and stored. Tried in this order; drivers without a key are skipped.
# "mymemory" and "ai" work without any key, so you can leave the rest empty.
TRANSLATE_DRIVERS=deepl,azure,libretranslate,mymemory,ai
# [OPTIONAL] free key (ends in :fx), 500K chars/month
DEEPL_API_KEY=
# [OPTIONAL] free F0 tier = 2M chars/month
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# [recommended] any real email: raises the free limit to 50,000 chars/day
MYMEMORY_EMAIL=
TRANSLATE_MAX_CHARS_PER_JOB=3500
TRANSLATE_PER_RUN=15
