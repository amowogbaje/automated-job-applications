##############################################################################
# HOW TO READ THIS FILE
#   [MUST]    the app will not work without it
#   [AI]      needed for resume parsing, research, discovery, outreach drafts
#             (you need AT LEAST ONE AI key, more = automatic fallback)
#   [SEARCH]  needed for research + discovery (AT LEAST ONE search key)
#   [OPTIONAL] leave empty / default if you don't need it
# Everything with a value already is a safe default.
##############################################################################

# ============================ [MUST] App & database ============================
APP_NAME="Opportunity Agent"
APP_ENV=production                # "local" on your own machine
APP_KEY=                          # [MUST] run: php artisan key:generate
APP_DEBUG=false                   # keep false on the live site
APP_URL=https://your-domain.com   # [MUST] your real URL (used in email links)
APP_TIMEZONE=Africa/Lagos         # daily email alerts go out after 07:00 in THIS timezone

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=                      # [MUST] from cPanel > MySQL Databases
DB_USERNAME=                      # [MUST]
DB_PASSWORD=                      # [MUST]

# Owner = who may open /agent (outreach tools). Comma separated. Empty = the first account registered.
AGENT_OWNER_EMAILS=

# cPanel-friendly defaults: no Redis/Node needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database         # needs the queue cron (see README)
CACHE_STORE=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ============================ [MUST for emails] Mail ============================
# Job alerts, password resets. MAIL_MAILER=log just writes emails to storage/logs (nothing is sent).
# On cPanel: create a mailbox, then use smtp with its details.
MAIL_MAILER=smtp
MAIL_HOST=                        # e.g. mail.your-domain.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="alerts@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================ [AI] Choose at least one ============================
# Managed on the Providers page (/agent/providers): order, on/off, daily limits, test button.
GEMINI_API_KEY=                   # free: aistudio.google.com/apikey
GROQ_API_KEY=                     # free: console.groq.com/keys  (also used for resume parsing)
DEEPSEEK_API_KEY=                 # platform.deepseek.com
# Optional model overrides (defaults are set in config/ai.php):
# GEMINI_MODEL=
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=
# Keep these on "failover" so every AI feature uses the providers above:
AI_PROVIDER=failover
RESUME_AI_PROVIDER=failover
# Old single-provider options, only if you switch AI_PROVIDER away from failover:
# AGNES_API_KEY=
# ANTHROPIC_API_KEY=
# Safety caps (per day / per call):
AI_CALLS_PER_DAY=300
AI_TIMEOUT=60

# ============================ [SEARCH] Choose at least one ============================
# Used by Research and Discovery. Switch between them on the Providers page.
TAVILY_API_KEY=                   # free tier: tavily.com
SERPER_API_KEY=                   # free tier: serper.dev
BRAVE_SEARCH_API_KEY=             # api.search.brave.com (may ask for a card)
SERPAPI_API_KEY=                  # serpapi.com, free plan ~250 searches/month
EXA_API_KEY=                      # dashboard.exa.ai, free credits on signup
FIRECRAWL_API_KEY=                # firecrawl.dev, free monthly credits
JINA_API_KEY=                     # jina.ai, free key with token allowance
SEARXNG_URL=                      # your own SearXNG instance, e.g. https://search.example.com (no key)
SEARCH_CALLS_PER_DAY=150

# ============================ Research & Discovery behaviour ============================
RESEARCH_RUN_MODE=queue           # "sync" runs inside the page request if you can't set up the queue cron
RESEARCH_CONTACT_EMAIL=           # [recommended] your email, shown in the crawler's User-Agent so sites can reach you

DISCOVERY_MAX_QUERIES=4           # searches per discovery run
DISCOVERY_RESULTS_PER_QUERY=6
DISCOVERY_MAX_CANDIDATES=12       # new opportunities saved per run
DISCOVERY_RUNS_PER_DAY=12         # protects your free search/AI quotas
DISCOVERY_AUTO_RESEARCH_CAP=5
DISCOVERY_SCHEDULE=off            # off | daily (05:30, hiring + external-assistance for every active service)

# ============================ Job feed sources ============================
# Arbeitnow, RemoteOK, WeWorkRemotely and Himalayas need NO key.
ADZUNA_APP_ID=                    # [OPTIONAL] free: developer.adzuna.com
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb                 # gb, us, ng, de ...
ADZUNA_SEARCH_TERM="software developer"

# Company job boards to read (no key needed), comma separated vendor:slug.
# Each user can also add their own on the Job interests page.
ATS_BOARDS=                       # e.g. greenhouse:stripe,lever:spotify,ashby:linear

# ============================ Social hiring posts ============================
SOCIAL_SOURCES=hackernews,mastodon,bluesky,lemmy     # add reddit, github, x once configured
SOCIAL_LOOKBACK_HOURS=48
SOCIAL_AI_PER_RUN=20              # AI extractions per run (only posts that already match someone's skills)
MASTODON_INSTANCES=mastodon.social,fosstodon.org
BLUESKY_HANDLE=                   # [OPTIONAL] free account, e.g. you.bsky.social
BLUESKY_APP_PASSWORD=             # Bluesky > Settings > App Passwords (NOT your main password)
LEMMY_INSTANCES=lemmy.world,programming.dev
LEMMY_COMMUNITIES=
REDDIT_CLIENT_ID=                 # [OPTIONAL] reddit.com/prefs/apps (non-commercial use)
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="web:job-feed:1.0 (by /u/your-reddit-username)"
REDDIT_SUBREDDITS=forhire
GITHUB_JOB_REPOS=                 # owner/repo,owner/repo (repos that post openings as issues)
GITHUB_TOKEN=
X_BEARER_TOKEN=                   # [OPTIONAL, paid] leave empty to keep X off
X_DAILY_READ_BUDGET=150

# ============================ Translation (non-English jobs) ============================
# Translated once and stored. Tried in this order; drivers without a key are skipped.
# "mymemory" and "ai" work without any key, so you can leave the rest empty.
TRANSLATE_DRIVERS=deepl,azure,libretranslate,mymemory,ai
DEEPL_API_KEY=                    # [OPTIONAL] free key (ends in :fx), 500K chars/month
AZURE_TRANSLATOR_KEY=             # [OPTIONAL] free F0 tier = 2M chars/month
AZURE_TRANSLATOR_REGION=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MYMEMORY_EMAIL=                   # [recommended] any real email: raises the free limit to 50,000 chars/day
TRANSLATE_MAX_CHARS_PER_JOB=3500
TRANSLATE_PER_RUN=15
