APP_NAME="Task Manager"
APP_ENV=local
APP_KEY=base64:HmE1CqTktqgGDHYRqNnZzGPg2o3nsT49j07PEUIwt68=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=task_manager
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"


# Add these lines to your project's .env file

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

JOB_KEYWORDS=laravel,php,full-stack,vue,react
JOB_REQUIRED_SKILLS=laravel,php
JOB_MIN_REQUIRED_MATCHES=1
JOB_EXCLUDED_KEYWORDS=wordpress,junior,unpaid,internship


# Which AI provider AiClientInterface resolves to. "groq" is free — sign up
# with no card at https://console.groq.com/keys — and is the default. Used
# for cover letters / application emails.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# The resume pipeline (parsing your PDF/site, tailoring per job) uses its
# own provider, independent of AI_PROVIDER above. Defaults to Agnes AI —
# also free, no card required — sign up at https://agnes-ai.com.
RESUME_AI_PROVIDER=agnes
AGNES_API_KEY=
AGNES_MODEL=agnes-2.0-flash

# Optional paid fallback — used if you set AI_PROVIDER=anthropic and/or
# RESUME_AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Company/contact discovery for the leads pipeline (/leads/discover).
# Free key at https://hunter.io — 25 Discover calls + 50 searches/month
# on the free tier. Leave blank and the discover form just tells you to
# set it; nothing else in the app depends on it.
HUNTER_API_KEY=

# Set this to your real email once you're ready to go live. Until then,
# every "email application" is generated as a draft under /drafts instead
# of actually being sent — review a batch before flipping this on.
AUTO_SEND_APPLICATIONS=false
RESUME_PDF_PATH=/absolute/path/to/your/resume.pdf
MAIL_DIGEST_TO=you@example.com

# Standard Laravel mail config — set these to a real SMTP provider
# (Mailgun, Postmark, SES, Gmail app password, etc.) so sending actually works.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME="Gideon Amowogbaje"
